# Rust/Cargo
target/
# Cargo.lock is committed. This repo builds its own binaries — the xtask and the
# two examples — so the lockfile pins what CI and local runs compile.

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit — generated by devenv's git-hooks module, not authored here.
.pre-commit-config.yaml

# Nix build results
result
result-*

# Editor
.vscode/
.idea/

# macOS
.DS_Store

# Internal tracking. Anchored with a leading slash deliberately: git matches a
# bare `todo.md` pattern at ANY depth, so an unanchored entry here would also
# swallow e.g. `docs/todo.md` in a project that wants to commit one.
/todo.md
/TODO.md

# The assembled .app bundle that run-rs.sh builds for launching.
build/

# Local, per-machine agent/editor state — never project config.
.claude/settings.local.json

# Agent worktrees and local tool state — never project content.
.claude/
